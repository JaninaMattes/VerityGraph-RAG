# docker/.env.example
# ==============================================================================
# POSTGRESQL (Metadata & State)
# ==============================================================================
POSTGRES_DB=postgres_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<YOUR-PASSWORD>
POSTGRES_MULTIPLE_DATABASES=temporal_db,temporal_user:temporal_visibility_db,temporal_user # Syntax: dbname1,username1:dbname2,username2

# ==============================================================================
# CACHE (REDIS)
# ==============================================================================
# Use 'localhost' for local dev, 'redis' if running inside Docker
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=<YOUR-PASSWORD>

# ==============================================================================
# MINIO / S3 STORAGE (Blob Storage)
# ==============================================================================
# Use 'localhost' for local dev, 'minio' if running inside Docker
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=<YOUR-PASSWORD>
MINIO_URL=http://minio:9000
MINIO_DEFAULT_BUCKETS=files
MINIO_NOTIFY_KAFKA_QUEUE_DIR_PRIMARY=/opt/minio/events
MINIO_NOTIFY_KAFKA_QUEUE_LIMIT_PRIMARY=1000
MINIO_NOTIFY_KAFKA_BATCH_SIZE_PRIMARY=100
MINIO_NOTIFY_KAFKA_ENABLE_PRIMARY=on
MINIO_NOTIFY_KAFKA_BROKERS_PRIMARY=kafka-kraft:9092
MINIO_NOTIFY_KAFKA_TOPIC_PRIMARY=minio-events

# ==============================================================================
# MESSAGE BROKER (REDPANDA / KAFKA) 
# ==============================================================================
# Port 9092 is the 'OUTSIDE' listener mapped to localhost in docker-compose
# If Python worker runs IN Docker, use 'kafka-kraft:9092'. 
# If Python worker runs ON YOUR HOST MACHINE, use 'localhost:9092'.
KAFKA_NODE_ID=1
KAFKA_BROKER_ID=1
DYNAMIC_CONFIG_ENABLED=true
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_DEFAULT_REPLICATION_FACTOR=1
KAFKA_MIN_INSYNC_REPLICAS=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_CLUSTERS_0_NAME=local-cluster
CLUSTER_ID=<YOUR-CLUSTER-ID>

# ==============================================================================
# TEMPORAL (Workflow Orchestration)
# ==============================================================================
# Use 'localhost' for local dev, 'temporal' if running inside Docker
TEMPORAL_URL=temporal:7233
POSTGRES_SEEDS=postgres
TEMPORAL_CORS_ORIGIN=http://localhost:8080,http://localhost:3000 # (e.g. FastAPI Backend, React Frontend)
TEMPORAL_POSTGRES_DB=temporal_db
TEMPORAL_POSTGRES_USER=temporal_user
TEMPORAL_POSTGRES_PASSWORD=<YOUR-PASSWORD>
TEMPORAL_POSTGRES_VISIBILITY_DB=temporal_visibility_db
SKIP_SCHEMA_SETUP=true
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=graphrag-tasks

# ==============================================================================
# GRAPH DATABASE (NEO4J) 
# ==============================================================================
# Use 'localhost' for local dev, 'neo4j' if running inside Docker
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<YOUR-NEO4J-KEY>

# ==============================================================================
# VECTOR DATABASE (QDRANT) 
# ==============================================================================
# Use 'localhost' for local dev, 'qdrant' if running inside Docker
QDRANT_URL=localhost:6333
QDRANT_COLLECTION=graphrag-collection
QDRANT_API_KEY=<YOUR-QDRANT-KEY>

# ==============================================================================
# PGADMIN (Observability)
# ==============================================================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=<YOUR-PASSWORD>
PGADMIN_COOKIE_PROTECTION=false

# ==============================================================================
# FRONTEND
# ==============================================================================
# Use 'localhost' for local dev, 'reactt' if running inside Docker
FRONTEND_URL=http://localhost:3000