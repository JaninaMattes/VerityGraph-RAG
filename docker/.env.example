# ==============================================================================
# POSTGRESQL (Metadata & State)
# ==============================================================================
POSTGRES_DB=graphrag_db
POSTGRES_USER=graphrag_user
POSTGRES_PASSWORD=graphrag_password

# ==============================================================================
# MINIO / S3 STORAGE (Blob Storage)
# ==============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_DEFAULT_BUCKETS=files
MINIO_NOTIFY_KAFKA_ENABLE_PRIMARY=on

# ==============================================================================
# CACHE (REDIS)
# ==============================================================================
# Use 'localhost' for local dev, 'redis' if running inside Docker
CACHE_URL=redis://localhost:6379/0

# ==============================================================================
# GRAPH DATABASE (NEO4J) - NEW
# ==============================================================================
# Use 'localhost' for local dev, 'neo4j' if running inside Docker
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<neo4j_password>

# ==============================================================================
# VECTOR DATABASE (QDRANT) - NEW
# ==============================================================================
# Use 'localhost' for local dev, 'qdrant' if running inside Docker
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=graphrag_chunks
QDRANT_API_KEY=<qdrant_api_key>

# ==============================================================================
# MESSAGE BROKER (REDPANDA / KAFKA) - NEW
# ==============================================================================
# Port 9092 is the 'OUTSIDE' listener mapped to localhost in docker-compose
# If Python worker runs IN Docker, use 'kafka:9092'. 
# If Python worker runs ON YOUR HOST MACHINE, use 'localhost:9094'.
KAFKA_NODE_ID=1
CLUSTER_ID=<cluster-id>
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_NUM_PARTITIONS=3
DYNAMIC_CONFIG_ENABLED=true
KAFKA_CLUSTERS_0_NAME=local-cluster

# ==============================================================================
# TEMPORAL (Workflow Orchestration)
# ==============================================================================
# Use 'localhost' for local dev, 'temporal' if running inside Docker
TEMPORAL_ENDPOINT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=graphrag-tasks

# ==============================================================================
# PGADMIN (Observability)
# ==============================================================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
PGADMIN_COOKIE_PROTECTION=False

# ==============================================================================
# FRONTEND
# ==============================================================================
FRONTEND_URL=http://localhost:3000