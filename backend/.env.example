#backend/.env.example
# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_NAME=MCP-powered Graph RAG Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
API_PREFIX=/api/v1

# Security (Generate a real secret key for production: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change_this_to_a_secure_random_string_for_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# CACHE (REDIS)
# ==============================================================================
# Use 'localhost' for local dev, 'redis' if running inside Docker
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=<YOUR-PASSWORD>

# ==============================================================================
# POSTGRESQL
# ==============================================================================
POSTGRES_URL=postgresql+asyncpg://<YOUR-USER>:<YOUR-PASSWORD>@localhost:5432/postgres_db
POSTGRES_ECHO=true

# ==============================================================================
# MINIO / S3 BLOB STORAGE
# ==============================================================================
# Use 'localhost' for local dev, 'minio' if running inside Docker
MINIO_URL=localhost:9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=<YOUR-PASSWORD>
MINIO_DEFAULT_BUCKETS=files
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_SSE_CUSTOMER_KEY=local-dev-sse-key-32-chars-min

# ==============================================================================
# MESSAGE BROKER (REDPANDA / KAFKA) 
# ==============================================================================
# Port 9092 is the 'OUTSIDE' listener mapped to localhost in docker-compose
# If Python worker runs IN Docker, use 'kafka-kraft:9092'
# If Python worker runs ON YOUR HOST MACHINE, use 'localhost:9092'
KAFKA_URL=kafka-kraft:9092s
KAFKA_TOPICS=minio-events
KAFKA_GROUP_ID=minio-ingestion-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=true

# ==============================================================================
# TEMPORAL (Workflow Orchestration)
# ==============================================================================
# Use 'localhost' for local dev, 'temporal' if running inside Docker
TEMPORAL_URL=temporal:7233
TEMPORAL_DEFAULT_NAMESPACE=default
TEMPORAL_TASK_QUEUE=graphrag-tasks

# ==============================================================================
# FRONTEND
# ==============================================================================
# Use 'localhost' for local dev, 'react' if running inside Docker
FRONTEND_URL=http://react:3000