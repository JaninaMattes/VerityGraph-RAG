# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_NAME=MCP-powered Graph RAG Backend
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Security (Generate a real secret key for production: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=your-super-secret-local-dev-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# POSTGRESQL (Used by docker-compose AND FastAPI)
# ==============================================================================
POSTGRES_USER=graphrag_user
POSTGRES_PASSWORD=graphrag_password
POSTGRES_DB=graphrag_db

# FastAPI Database URL (Use 'postgres' as host if FastAPI runs in Docker, 'localhost' if running locally via uvicorn)
POSTGRES_URL=postgresql+asyncpg://graphrag_user:graphrag_password@localhost:5432/graphrag_db
POSTGRES_ECHO=true

# ==============================================================================
# MINIO / S3 STORAGE (Used by docker-compose AND FastAPI)
# ==============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_DEFAULT_BUCKETS=default

# FastAPI Storage Settings
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_SSE_CUSTOMER_KEY=local-dev-sse-key-32-chars-min!!

# ==============================================================================
# PGADMIN
# ==============================================================================
PGADMIN_DEFAULT_EMAIL=admin@graphrag.local
PGADMIN_DEFAULT_PASSWORD=admin123

# ==============================================================================
# CACHE (REDIS)
# ==============================================================================
CACHE_URL=redis://localhost:6379/0

# ==============================================================================
# TEMPORAL (Workflow Engine)
# ==============================================================================
TEMPORAL_ENDPOINT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=graphrag-tasks

# ==============================================================================
# FRONTEND
# ==============================================================================
FRONTEND_URL=http://localhost:3000