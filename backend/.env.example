#backend/.env.example

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_NAME=Graph RAG Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
API_PREFIX=/api/v1

# Signs the access tokens; at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<YOUR-SECRET-KEY>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# POSTGRESQL
# ==============================================================================
POSTGRES_URL=postgresql+asyncpg://<YOUR-USER>:<YOUR-PASSWORD>@localhost:5432/postgres_db
POSTGRES_ECHO=false
POSTGRES_POOL_SIZE=5

# ==============================================================================
# MINIO / S3 STORAGE
# ==============================================================================
# Use 'localhost' for local dev, 'minio' if running inside Docker
MINIO_URL=localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=<YOUR-PASSWORD>
MINIO_DEFAULT_BUCKETS=files
MINIO_REGION=us-east-1
MINIO_SECURE=false

# ==============================================================================
# MESSAGE BROKER (REDPANDA / KAFKA) 
# ==============================================================================
# If the worker runs IN Docker, use 'kafka-kraft:9092'.
# If the worker runs ON YOUR HOST MACHINE, use the external listener 'localhost:9094'.
KAFKA_BOOTSTRAP_SERVERS=kafka-kraft:9092
KAFKA_TOPICS=["minio-events"]
KAFKA_GROUP_ID=minio-kafka-group
KAFKA_AUTO_OFFSET_RESET=earliest

# ==============================================================================
# TEMPORAL (Workflow Orchestration)
# ==============================================================================
# Use 'localhost' for local dev, 'temporal' if running inside Docker
TEMPORAL_URL=temporal:7233
TEMPORAL_DEFAULT_NAMESPACE=default
TEMPORAL_TASK_QUEUE=temporal-task-queue

# ==============================================================================
# CHUNKING (ingestion worker, Docling)
# ==============================================================================
# Use the tokenizer of the embedding model, so no chunk exceeds its input size.
CHUNK_TOKENIZER_MODEL=BAAI/bge-small-en-v1.5
CHUNK_MAX_TOKENS=512
# OCR is slow; digital PDFs have a text layer. Set true for scanned documents.
DOCLING_DO_OCR=false
# A presigned upload cannot limit its size: the worker refuses larger files
# (FAILED, not retried) before it downloads or parses them.
MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_PAGES=500
# Files that one worker process parses at the same time (own Temporal task queue).
MAX_CONCURRENT_PARSES=1

# ==============================================================================
# FRONTEND
# ==============================================================================
# Use 'localhost' for local dev, 'react' if running inside Docker
FRONTEND_URL=http://localhost:3000